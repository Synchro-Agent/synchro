# Bỏ comment và điền để bật model thật (khi trống, app dùng trả lời giả lập)
# NEXT_PUBLIC_LLM_ENDPOINT=/api/llm
# LLM_PROVIDER=anthropic        # hoặc openai
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=https://api.openai.com/v1

# --- Tài khoản & đăng nhập ---
# URL công khai của web (dùng để tạo redirect URI cho OAuth)
# APP_URL=https://synchro.net.nz
# Email quản trị viên (cách nhau bởi dấu phẩy). Tạo mật khẩu bằng: node scripts/create-admin.mjs
# ADMIN_EMAILS=nguyenhuulamtung@gmail.com
# Google — redirect URI: <APP_URL>/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub — callback URL: <APP_URL>/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Apple — Services ID làm APPLE_CLIENT_ID; return URL: <APP_URL>/api/auth/oauth/apple/callback
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
