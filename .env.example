# Bỏ comment và điền để bật model thật (khi trống, app dùng trả lời giả lập)
# NEXT_PUBLIC_LLM_ENDPOINT=/api/llm
# LLM_PROVIDER=anthropic        # hoặc openai
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=https://api.openai.com/v1

# --- Tài khoản & đăng nhập ---
# URL công khai của web (dùng để tạo redirect URI cho OAuth)
# APP_URL=https://synchro.net.nz
# Email quản trị viên (cách nhau bởi dấu phẩy). Tạo mật khẩu bằng: node scripts/create-admin.mjs
# ADMIN_EMAILS=nguyenhuulamtung@gmail.com
# Google — redirect URI: <APP_URL>/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub — callback URL: <APP_URL>/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Apple — Services ID làm APPLE_CLIENT_ID; return URL: <APP_URL>/api/auth/oauth/apple/callback
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Workspace của Synchro Code (terminal, trình duyệt, agent) ---
# workspace/setup.sh (chạy bằng root trên VPS) tự tạo hai biến này và dịch vụ synchro-ws.
# WS_AGENT_URL=http://127.0.0.1:3555
# WS_AGENT_SECRET=
# Địa chỉ WebSocket cho trình duyệt (mặc định: <APP_URL đổi http->ws>/ws-agent)
# WS_PUBLIC_URL=
# Kết nối GitHub (nút GitHub trong Synchro Code) dùng lại GITHUB_CLIENT_ID/SECRET ở trên, xin thêm quyền "repo".
# Token GitHub được mã hóa bằng khóa suy ra từ DATA_KEY (mặc định: GITHUB_CLIENT_SECRET).
# DATA_KEY=

# Connector: dò trước trang đăng nhập của hãng để báo lỗi rõ khi hãng từ chối Synchro. Đặt 0 để tắt nếu một hãng bị chặn nhầm.
# CONNECTOR_PREFLIGHT=0
