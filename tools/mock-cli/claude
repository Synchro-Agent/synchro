#!/usr/bin/env node
// Claude Code giả lập (dev:mock): auth status|login|logout, setup-token (cần terminal), -p --output-format stream-json.
// Trong prompt: [mock:quota] → hết hạn mức gói, [mock:auth401] → API trả 401 (token bị thu hồi), [mock:ratelimit] → giới hạn tốc độ ngắn,
// [mock:weekopus] → chỉ hết hạn mức tuần của Opus, [mock:midquota] → viết được một đoạn rồi hết hạn mức, [mock:hang] → khởi động xong rồi treo,
// [mock:retrying] → CLI báo đang thử lại rồi trả lời, [mock:quotaonce] → hết hạn mức ở lượt có công cụ sau khi đã chạy công cụ.
const C = require(require("path").join(__dirname, "mock-cli-common.cjs"));
const { fs, path } = C;
const a = process.argv.slice(2);
C.gate(a);
// Hướng dẫn hệ thống: --system-prompt <chữ> hoặc --system-prompt-file <tệp> (Synchro dùng tệp khi hướng dẫn dài; bản cũ dùng --append-…).
const sysFlag = (n) => C.flag(a, n) ?? (C.flag(a, n + "-file") ? fs.readFileSync(C.flag(a, n + "-file"), "utf8") : undefined);
const SYS = sysFlag("--system-prompt") ?? sysFlag("--append-system-prompt");
const dir = process.env.CLAUDE_CONFIG_DIR || path.join(process.env.HOME || "/tmp", ".claude");
const loginFile = path.join(dir, ".mock-login");

(async () => {
  if (a[0] === "--version") return console.log(C.version("2.1.310 (Claude Code) [mock]"));
  if (a[0] === "auth" && a[1] === "status") {
    const li = fs.existsSync(loginFile);
    console.log(JSON.stringify({ loggedIn: li, authMethod: li ? "claude.ai" : "none", apiProvider: "firstParty", configDirectory: dir, ...(li ? { email: "owner@example.com", subscriptionType: "max" } : {}) }));
    process.exit(li ? 0 : 1);
  }
  if (a[0] === "auth" && a[1] === "logout") { fs.rmSync(loginFile, { force: true }); return console.log("Successfully logged out from your Anthropic account."); }
  if ((a[0] === "auth" && a[1] === "login") || a[0] === "setup-token") {
    if (a[0] === "setup-token" && !process.stdin.isTTY) { console.error("Error: Raw mode is not supported on the current process.stdin."); process.exit(1); }
    console.log("Opening browser to sign in…\nBrowser didn't open? Use the url below to sign in (c to copy)\n");
    console.log(`${C.cfg.base}/mock-login/claude?code=true&client_id=mock&redirect_uri=https%3A%2F%2Fplatform.claude.com%2Foauth%2Fcode%2Fcallback&state=${C.uuid()}`);
    const code = await C.readLine("\nPaste code here if prompted > ");
    // Như Claude Code thật: mã sai thì báo lỗi rồi đứng chờ Enter để thử lại (không thoát).
    if (code !== "MOCK-CLAUDE-OK") { console.log("\n OAuth error: Request failed with status code 400 Press Enter to retry."); await new Promise(() => {}); }
    if (a[0] === "setup-token") {
      // Token in làm hai đợt (như terminal nhận theo từng gói dữ liệu), rồi mới tới câu "Store this token".
      const tok = `sk-ant-oat01-MOCK${C.crypto.randomBytes(40).toString("hex")}`;
      fs.mkdirSync(dir, { recursive: true }); fs.writeFileSync(path.join(dir, ".mock-last-token"), tok);
      // Như Claude Code thật trong terminal giả: nhiều câu in liền không dấu cách, in xong token là thoát ngay.
      process.stdout.write(`\n✓ Long-lived authentication token created successfully!\n\nYourOAuthtoken(validfor1year):\n\n${tok.slice(0, 30)}`);
      await C.sleep(150);
      process.stdout.write(`${tok.slice(30)}\n\nStorethistokensecurely.Youwon'tbeabletoseeitagain.\nUsethistokenbysetting:exportCLAUDE_CODE_OAUTH_TOKEN=<token>\n`);
    } else { fs.mkdirSync(dir, { recursive: true }); fs.writeFileSync(loginFile, "1"); console.log("\nLogin successful."); }
    process.exit(0);
  }
  if (a.includes("-p")) {
    // Thời gian khởi động giả lập (mock-cli.json: startMs), để kiểm thử thấy tiến trình khởi động sẵn nhanh hơn thật.
    await C.sleep(C.cfg.startMs ?? 0);
    // --fork-session (phiên ấm của Synchro): nối từ phiên có sẵn nhưng dưới mã phiên mới, như CLI thật.
    const sid = a.includes("--fork-session") ? C.uuid() : C.flag(a, "--resume") || C.uuid();
    // Tên gọi tắt → model thật (như Claude Code báo trong system/init).
    let inited = false;
    const ALIAS = { fable: "claude-fable-5-1", opus: "claude-opus-5-5", sonnet: "claude-sonnet-5-5", haiku: "claude-haiku-5-5" };
    const blocks = (m, media) => { let t = ""; for (const b of m.message?.content ?? []) { if (b.type === "text") t += b.text; else if ((b.type === "image" || b.type === "document") && b.source?.type === "base64") media.push(`${C.mediaDesc(Buffer.from(b.source.data, "base64"), b.source.media_type)} (${b.type})`); } return t; };
    // --input-format stream-json: mỗi dòng là một tin nhắn người dùng (khối chữ, ảnh, PDF như Messages API), mỗi tin là một lượt; tiến trình sống tới khi stdin đóng, như CLI thật.
    // Không có cờ đó: toàn bộ stdin là prompt của một lượt.
    if (C.flag(a, "--input-format") === "stream-json") {
      if (C.cfg.deafStream) return new Promise(() => {}); // CLI giả không xử lý stream-json: im lặng mãi (kiểm thử rơi về cách cũ).
      if (C.cfg.dieStream) { console.error("unknown option '--input-format'"); process.exit(1); }
      for await (const l of require("readline").createInterface({ input: process.stdin })) {
        if (!l.trim()) continue;
        const media = [];
        await oneTurn(blocks(JSON.parse(l), media), media);
      }
      return;
    }
    await oneTurn(await C.readStdin(), []);
    return;
    async function oneTurn(raw, media) {
    let prompt = raw;
    // Ghi chú nhớ lại từ bộ não Synchro ghép vào cuối tin nhắn: không phải câu người dùng gõ (không đọc lệnh thử trong đó).
    prompt = prompt.replace(/<brain_recall>[\s\S]*?<\/brain_recall>/g, "").trim();
    const ok = (process.env.CLAUDE_CODE_OAUTH_TOKEN || "").startsWith("sk-ant-oat01-MOCK") || fs.existsSync(loginFile);
    // Lịch sử phiên trên đĩa như CLI thật (nguyên văn tin nhắn): kiểm thử xóa đoạn chat, đoạn chat ẩn danh.
    if (ok) { const pd = path.join(dir, "projects", "mock"); fs.mkdirSync(pd, { recursive: true }); fs.appendFileSync(path.join(pd, `${sid}.jsonl`), JSON.stringify({ prompt }) + "\n"); }
    // initOnce: CLI chỉ in init ở lượt đầu của tiến trình (mã phiên của lượt sau đọc từ result).
    if (!C.cfg.initOnce || !inited) C.out({ type: "system", subtype: "init", session_id: sid, model: ALIAS[C.flag(a, "--model")] ?? C.flag(a, "--model") ?? "claude-sonnet-5-5", cwd: process.cwd(), tools: [] });
    inited = true;
    const result = (o) => C.out({ type: "result", session_id: sid, usage: { input_tokens: 0, output_tokens: 0 }, total_cost_usd: 0, ...o });
    if (!ok) { result({ subtype: "success", is_error: true, result: "Not logged in · Please run /login" }); process.exit(1); }
    if (prompt.includes("[mock:auth401]")) { C.out({ type: "system", subtype: "api_retry", attempt: 1, max_retries: 10, retry_delay_ms: 600, error_status: 401, error: "authentication_failed" }); await C.sleep(60_000); return; }
    const turn = C.bumpSession(dir, sid), lim = C.bumpUsage(dir);
    // Đúng định dạng của Claude Code: unifiedWindows (utilization 0–1, resetsAt tính bằng giây) và cửa sổ đang gần chạm nhất ở cấp ngoài.
    const sec = (t) => Math.floor(t / 1000), st = (u) => (u >= 1 ? "rejected" : u >= 0.8 ? "allowed_warning" : "allowed");
    C.out({ type: "rate_limit_event", uuid: C.uuid(), session_id: sid, rate_limit_info: {
      status: st(lim.five), rateLimitType: "five_hour", utilization: lim.five, resetsAt: sec(lim.fiveReset),
      unifiedWindows: { five_hour: { utilization: lim.five, resetsAt: sec(lim.fiveReset), status: st(lim.five) }, seven_day: { utilization: lim.week, resetsAt: sec(lim.weekReset), status: st(lim.week) } },
    } });
    if (prompt.includes("[mock:quota]")) {
      // Như Claude Code thật khi chạm giới hạn phiên: rate_limit_event "rejected" kèm mốc đặt lại, rồi lượt báo lỗi.
      C.out({ type: "rate_limit_event", uuid: C.uuid(), session_id: sid, rate_limit_info: { status: "rejected", rateLimitType: "five_hour", utilization: 1, resetsAt: sec(lim.fiveReset),
        unifiedWindows: { five_hour: { utilization: 1, resetsAt: sec(lim.fiveReset), status: "rejected" }, seven_day: { utilization: lim.week, resetsAt: sec(lim.weekReset), status: st(lim.week) } } } });
      result({ subtype: "success", is_error: true, result: `Claude AI usage limit reached|${sec(lim.fiveReset)}` });
      process.exit(1);
    }
    if (prompt.includes("[mock:hang]")) { await C.sleep(600_000); return; }
    if (prompt.includes("[mock:ratelimit]")) { result({ subtype: "success", is_error: true, result: "API Error: 429 rate_limit_error: Rate limit exceeded. Try again in 1 seconds." }); process.exit(1); }
    if (prompt.includes("[mock:weekopus]")) {
      C.out({ type: "rate_limit_event", uuid: C.uuid(), session_id: sid, rate_limit_info: { status: "rejected", rateLimitType: "seven_day_opus", utilization: 1, resetsAt: sec(Date.now() + 3 * 86400_000) } });
      result({ subtype: "success", is_error: true, result: "You've hit your Opus weekly limit" });
      process.exit(1);
    }
    if (prompt.includes("[mock:retrying]")) { C.out({ type: "system", subtype: "api_retry", attempt: 1, max_retries: 10, retry_delay_ms: 100, error_status: 529, error: "overloaded" }); await C.sleep(100); }
    const stl = C.stallTurn(dir, sid, prompt);
    if (stl.stall) { C.out({ type: "assistant", message: { role: "assistant", content: [{ type: "text", text: C.STALL_TEXT }] }, session_id: sid }); result({ subtype: "success", is_error: false, result: C.STALL_TEXT }); return; }
    prompt = stl.prompt;
    // #slow: lượt trả lời mất 3 giây (thử nhắn thêm khi CLI đang trả lời); lượt nối tiếp với tin nhắn thêm thì trả lời ngay.
    if (prompt.includes("#slow") && !prompt.includes("<user_followup>")) await C.sleep(3000);
    // Mỗi tin của model mở đầu bằng message_start rồi mới tới chữ, như Claude Code thật với --include-partial-messages.
    const delta = async (t) => { C.out({ type: "stream_event", event: { type: "message_start", message: { role: "assistant" } }, session_id: sid }); for (const ch of C.chunks(t)) { C.out({ type: "stream_event", event: { type: "content_block_delta", index: 0, delta: { type: "text_delta", text: ch } }, session_id: sid }); await C.sleep(15); } };
    if (prompt.includes("[mock:midquota]")) { await delta("Phần đã viết trước khi hết hạn mức."); result({ subtype: "success", is_error: true, result: "You've hit your usage limit" }); process.exit(1); }
    // [mock:twomsg]: hai tin trong một lượt (câu dẫn → công cụ dựng sẵn → câu trả lời).
    if (prompt.includes("[mock:twomsg]")) {
      await delta("Mình sẽ tìm trên web.");
      C.out({ type: "assistant", message: { role: "assistant", content: [{ type: "tool_use", id: "toolu_ws", name: "WebSearch", input: { query: "mock" } }] }, session_id: sid });
      C.out({ type: "user", message: { role: "user", content: [{ type: "tool_result", tool_use_id: "toolu_ws", content: 'Web search results for query: "mock"\n\nLinks: [{"title":"Nguồn giả","url":"https://example.com/nguon"}]' }] }, session_id: sid });
      await delta("Theo kết quả tìm web: xong.");
      result({ subtype: "success", is_error: false, result: "Theo kết quả tìm web: xong.", usage: { input_tokens: prompt.length, output_tokens: 20, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 } });
      return;
    }
    // Như Claude Code thật với --mcp-config: nhận cả chuỗi JSON lẫn ĐƯỜNG DẪN TỆP (Synchro gửi token MCP qua tệp 0600, không qua tham số).
    const cfgJson = (() => { let v = C.flag(a, "--mcp-config") ?? "null"; try { if (v !== "null" && fs.existsSync(v)) v = fs.readFileSync(v, "utf8"); } catch {} try { return JSON.parse(v); } catch { return null; } })();
    const mcpUrl = cfgJson?.mcpServers?.synchro?.url;
    const ask = C.toolAsk(prompt), allowed = (C.flag(a, "--allowedTools") ?? "").split(",");
    let mcpNote = "";
    if (mcpUrl) {
      if (ask && allowed.includes("mcp__synchro")) {
        // [mock:dieaftertool]: như model gọi công cụ ngay không có câu dẫn, rồi tiến trình chết trước khi viết chữ nào (Synchro không được chạy lại lượt: công cụ đã chạy).
        const die = prompt.includes("[mock:dieaftertool]");
        if (!die) await delta(`Mình sẽ dùng công cụ ${ask.name} của Synchro.`);
        // Như CLI thật: luồng đầu ra báo khối tool_use bắt đầu trước khi gọi máy chủ MCP.
        C.out({ type: "stream_event", event: { type: "content_block_start", index: 1, content_block: { type: "tool_use", id: "toolu_mock", name: `mcp__synchro__${ask.name}`, input: {} } }, session_id: sid });
        C.out({ type: "assistant", message: { role: "assistant", content: [{ type: "tool_use", id: "toolu_mock", name: `mcp__synchro__${ask.name}`, input: ask.args }] }, session_id: sid });
        const r = await C.mcp(mcpUrl, ask).catch((e) => ({ error: { message: String(e) } }));
        const out = r.error ? `lỗi ${r.error.message}` : (r.result?.content ?? []).map((c) => c.text).join("\n");
        mcpNote = ` [đã dùng ${ask.name}: ${out.replace(/\s+/g, " ").slice(0, 160)}]`;
        if (die) process.exit(1);
        if (prompt.includes("[mock:quotaonce]")) { await delta("Đã chạy công cụ, phần còn lại chưa xong."); result({ subtype: "success", is_error: true, result: "You've hit your usage limit" }); process.exit(1); }
      } else {
        const r = await C.mcp(mcpUrl).catch(() => ({ tools: [] }));
        mcpNote = ` [công cụ Synchro: ${r.tools.length}]`;
      }
    }
    // Đường nhanh (hướng dẫn có dấu [[CAN_CONG_CU]]): "latemarker" viết một câu rồi mới tới dấu; "notoolreply" trả lời
    // kiểu model nhanh không theo hướng dẫn ("mình không có công cụ…"). Synchro phải chạy lại cả hai ở lượt đầy đủ.
    const fastSys = /\[\[CAN_CONG_CU\]\]/.test(SYS ?? "");
    const late = !fastSys ? null : /latemarker/.test(prompt) ? "Việc này cần connector.\n[[CAN_CONG_CU]]"
      : /notoolreply/.test(prompt) ? "Mình không có công cụ Google Docs ở đây nên chưa tạo được tài liệu." : null;
    if (late) {
      await delta(late);
      const message = { role: "assistant", content: [{ type: "text", text: late }] };
      C.out({ type: "assistant", message, session_id: sid });
      const usage = { input_tokens: prompt.length, output_tokens: 20 };
      result({ subtype: "success", is_error: false, result: late, usage });
      return;
    }
    const web = (C.flag(a, "--tools") ?? "").includes("WebSearch") ? " [tìm web]" : "";
    // Cho kiểm thử biết Synchro có gửi kèm hướng dẫn artifact (--append-system-prompt) hay không.
    const text = /#pid/.test(prompt) ? `PID ${process.pid} lượt ${turn} hệ thống ${(SYS ?? "").length} ký tự` : /\[\[CAN_CONG_CU\]\]/.test(SYS ?? "") && /needtools/.test(prompt) ? "[[CAN_CONG_CU]]" : /#media/.test(prompt) && !C.isTitleAsk(prompt) && !C.mockBrain(prompt) ? C.mediaReply(media) : C.mockBrain(prompt) ?? (C.isTitleAsk(prompt) ? C.mockTitle(prompt) : /#prefs/.test(prompt) ? C.prefsEcho(`${SYS ?? ""}\n${prompt}`) : /#toprule/.test(prompt) ? C.ruleEcho(SYS ?? "") : /#pjins/.test(prompt) ? C.pjEcho(SYS ?? "") : C.reply("Claude", prompt, turn) + mcpNote + web + (/<artifacts>/.test(SYS ?? "") ? " [có hướng dẫn artifact]" : "") + (C.flag(a, "--effort") ? ` [effort ${C.flag(a, "--effort")}]` : ""));
    await delta(text);
    C.out({ type: "assistant", message: { role: "assistant", content: [{ type: "text", text }] }, session_id: sid });
    result({ subtype: "success", is_error: false, result: text, usage: { input_tokens: prompt.length, output_tokens: text.length, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 } });
    }
  }
  console.error(`mock claude: không hỗ trợ "${a.join(" ")}"`);
  process.exit(2);
})();
