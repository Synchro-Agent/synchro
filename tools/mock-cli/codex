#!/usr/bin/env node
// Codex CLI giả lập (dev:mock): login status|--device-auth, logout, exec [resume <id>] --json -, app-server (JSON-RPC: model/list, account/*, thread/start|resume, turn/start|interrupt).
// Trong prompt: [mock:quota] → hết hạn mức gói ChatGPT ([mock:quota:codex]: chỉ ChatGPT hết, model dự phòng của hãng khác vẫn trả lời).
const C = require(require("path").join(__dirname, "mock-cli-common.cjs"));
const { fs, path } = C;
const a = process.argv.slice(2);
C.gate(a);
const home = process.env.CODEX_HOME || path.join(process.env.HOME || "/tmp", ".codex");
// Lượt có công cụ: Synchro chạy codex với CODEX_HOME riêng của lượt (thư mục con .synchro-codex-* của thư mục đăng nhập), trong đó config.toml có
// cầu nối MCP và các mục khác là liên kết về thư mục đăng nhập. Trạng thái giả lập (đếm lượt, hạn mức…) luôn ở thư mục đăng nhập.
const dir = path.basename(home).startsWith(".synchro-codex-") ? path.dirname(home) : home;
// Như codex thật: auth.json đọc qua CODEX_HOME (liên kết trong thư mục của lượt).
const authFile = path.join(home, "auth.json");
const readJ = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return {}; } };
/** Như codex thật: máy chủ MCP chỉ đọc từ $CODEX_HOME/config.toml, bảng [mcp_servers.synchro] (không còn nhận qua -c). */
function mcpConfig() {
  let text = "";
  try { text = fs.readFileSync(path.join(home, "config.toml"), "utf8"); } catch { return {}; }
  const out = {};
  let inside = false, seen = 0;
  for (const raw of text.split("\n")) {
    const l = raw.trim();
    if (l.startsWith("[")) { inside = /^\[\s*mcp_servers\.("synchro"|synchro)\s*\]$/.test(l); if (inside) seen++; continue; }
    const m = inside && /^([\w-]+)\s*=\s*(.+)$/.exec(l);
    if (m) { try { out[m[1]] = JSON.parse(m[2]); } catch { out[m[1]] = m[2]; } }
  }
  // Bảng trùng tên là TOML hỏng: codex thật không chạy.
  if (seen > 1) { console.error("Error loading config.toml: duplicate key `synchro` in table `mcp_servers`"); process.exit(1); }
  return out;
}

// Lõi một lượt chat, dùng chung cho `exec` (sự kiện JSONL) và `app-server` (thông báo JSON-RPC): E là bộ phát sự kiện của từng đường.
// o = { prompt, tid, effort, web, nativeOn, mcp: { url, approved } | null, images: [đường dẫn], argvNote }
async function chatTurn(o, E) {
  let prompt = o.prompt;
  // [mock:codexnative]: như gói trả phí, model thấy image_gen dựng sẵn nếu Synchro không tắt: ảnh nằm trong thư mục trên máy chủ, không thành tệp của người dùng.
  if (prompt.includes("[mock:codexnative]")) {
    const f = path.join(dir, "generated_images", o.tid, "ig_native.png");
    if (o.nativeOn) C.saveImage(f, "png");
    await E.message("item_1", o.nativeOn ? `Saved ${f}` : "NATIVE_OFF");
    return E.done({ input_tokens: 1, cached_input_tokens: 0, output_tokens: 1 });
  }
  if (prompt.includes("[mock:quota]") || prompt.includes("[mock:quota:codex]")) return E.failed("You've hit your usage limit. Upgrade to Pro or try again in 2 hours 14 minutes.");
  const turn = C.bumpSession(dir, o.tid);
  const st = C.stallTurn(dir, o.tid, prompt);
  if (st.stall) { await E.message("item_1", C.STALL_TEXT); return E.done({ input_tokens: prompt.length, cached_input_tokens: 0, output_tokens: 10 }); }
  prompt = st.prompt;
  // Như codex thật khi còn công cụ shell (read-only vẫn đọc được cả đĩa): báo mục lệnh rồi mới chạy. [mock:shell] kiểm tra Synchro dừng lượt ngay
  // lúc đó: tiến trình còn sống sau 800 ms thì để lại dấu vết (coi như kết quả lệnh đã về tới model).
  if (prompt.includes("[mock:shell]")) {
    E.started({ id: "item_s", type: "command_execution", command: "cat ../../logins/codex/*/auth.json", status: "in_progress" });
    await C.sleep(800);
    fs.writeFileSync(path.join(dir, "shell-ran"), "1");
    await E.message("item_1", "đã đọc auth.json của người khác");
    return E.done({ input_tokens: 1, cached_input_tokens: 0, output_tokens: 1 });
  }
  // [mock:authrefresh]: như khi codex làm mới token: ghi auth.json mới rồi đổi tên đè lên (thay liên kết trong CODEX_HOME của lượt bằng tệp thật),
  // và tạo tệp mới (history.jsonl) trong CODEX_HOME. Synchro phải đưa cả hai về thư mục đăng nhập khi xong lượt.
  if (prompt.includes("[mock:authrefresh]")) {
    const tmp = path.join(home, "auth.json.tmp");
    fs.writeFileSync(tmp, JSON.stringify({ mock: true, refreshed: Date.now() }));
    fs.renameSync(tmp, authFile);
    fs.appendFileSync(path.join(home, "history.jsonl"), JSON.stringify({ ts: Date.now() }) + "\n");
  }
  await C.sleep(150);
  E.completed({ id: "item_0", type: "reasoning", text: "**Chào hỏi**" });
  // [mock:nativeplan]: như GPT qua Codex dùng update_plan DỰNG SẴN của Codex (không phải update_plan của Synchro): 3 việc, mỗi 1,5 giây xong một việc
  // (exec: mục todo_list item.started / item.updated / item.completed; app-server: turn/plan/updated). Synchro phải cập nhật danh sách việc ngay trong lượt.
  if (prompt.includes("[mock:nativeplan]") && !C.isTitleAsk(prompt)) {
    const steps = ["Đọc yêu cầu", "Dựng bảng lương", "Kiểm tra công thức"];
    for (let k = 0; k <= steps.length; k++) {
      if (k) await C.sleep(1500);
      E.plan(steps.map((t, j) => [t, j < k]), k === 0 ? "started" : k === steps.length ? "completed" : "updated");
    }
    await E.message("item_1", "Đã xong cả 3 việc theo danh sách.");
    return E.done({ input_tokens: prompt.length, cached_input_tokens: 0, output_tokens: 10 });
  }
  // [mock:slowcodex]: model nghĩ 2 giây rồi mới viết (thử bấm Dừng giữa lượt).
  if (prompt.includes("[mock:slowcodex]")) await C.sleep(2000);
  // Như codex thật với cầu nối MCP: lời dẫn, mcp_tool_call, rồi câu trả lời. Công cụ MCP chỉ chạy khi máy chủ được duyệt sẵn (default_tools_approval_mode="approve").
  const mcpUrl = o.mcp?.url ?? null;
  const ask = C.toolAsk(prompt);
  let note = "";
  // [mock:argv]: in lại tham số dòng lệnh (kiểm thử: địa chỉ cầu nối không được nằm trên dòng lệnh).
  if (prompt.includes("[mock:argv]")) note += o.argvNote;
  if (mcpUrl && ask) {
    await E.message("item_n", `Mình sẽ dùng công cụ ${ask.name} của Synchro.`);
    E.started({ id: "item_t", type: "mcp_tool_call", server: "synchro", tool: ask.name });
    const r = o.mcp.approved ? await C.mcp(mcpUrl, ask).catch((e) => ({ error: { message: String(e) } })) : { error: { message: "MCP tool call requires approval, but approval policy is never" } };
    E.completed({ id: "item_t", type: "mcp_tool_call", server: "synchro", tool: ask.name, status: r.error ? "failed" : "completed" });
    note += ` [đã dùng ${ask.name}: ${(r.error ? r.error.message : (r.result?.content ?? []).map((c) => c.text).join(" ")).replace(/\s+/g, " ").slice(0, 160)}]`;
  } else if (mcpUrl) note += ` [công cụ Synchro: ${(await C.mcp(mcpUrl).catch(() => ({ tools: [] }))).tools.length}]`;
  if (o.web) {
    note += " [tìm web]";
    if (prompt.includes("#web")) { E.started({ id: "item_w", type: "web_search", query: "" }); E.completed({ id: "item_w", type: "web_search", query: "mock", action: { type: "search", query: "mock" } }); }
  }
  // Ảnh gửi kèm: đọc đúng tệp ảnh như codex thật (tệp không có thì báo lỗi).
  const missing = o.images.find((f) => !fs.existsSync(f));
  if (missing) return E.failed(`Failed to read image ${missing}: No such file or directory`);
  const eff = o.effort;
  // "#pjins": phần dự án phiên này đang có, nhớ theo phiên như lịch sử của Codex thật.
  if (/#pjins/.test(prompt) && !C.isTitleAsk(prompt) && !C.mockBrain(prompt)) {
    const pj = C.pjSession(dir, o.tid, prompt);
    await E.message("item_1", pj);
    return E.done({ input_tokens: prompt.length, cached_input_tokens: 0, output_tokens: pj.length });
  }
  const critic = C.criticReply(prompt, o.images);
  if (critic) {
    await E.message("item_1", critic);
    return E.done({ input_tokens: prompt.length, cached_input_tokens: 0, output_tokens: critic.length });
  }
  const text = /#media/.test(prompt) && !C.isTitleAsk(prompt) && !C.mockBrain(prompt) ? C.mediaReply(o.images.map((f) => `${C.mediaDesc(fs.readFileSync(f))} (--image)`)) : C.mockBrain(prompt) ?? (C.isTitleAsk(prompt) ? C.mockTitle(prompt) : /#prefs/.test(prompt) ? C.prefsEcho(prompt) : C.reply("Codex (ChatGPT)", prompt, turn) + note + (eff ? ` [effort ${eff}]` : ""));
  await E.message("item_1", text);
  return E.done({ input_tokens: prompt.length, cached_input_tokens: 0, output_tokens: text.length });
}
// app-server: tên loại mục theo giao thức v2 (camelCase).
const CAMEL = { agent_message: "agentMessage", mcp_tool_call: "mcpToolCall", web_search: "webSearch", command_execution: "commandExecution", reasoning: "reasoning" };
const appLog = (method, extra = {}) => { try { fs.appendFileSync(path.join(dir, "mock-appserver.log"), JSON.stringify({ at: Date.now(), pid: process.pid, method, ...extra }) + "\n"); } catch {} };

(async () => {
  if (a[0] === "--version") return console.log(C.version("codex-cli 0.164.0 [mock]"));
  if (a[0] === "login" && a[1] === "status") {
    if (fs.existsSync(authFile)) { console.error("Logged in using ChatGPT"); process.exit(0); }
    console.error("Not logged in"); process.exit(1);
  }
  if (a[0] === "logout") { fs.rmSync(authFile, { force: true }); return console.error("Successfully logged out"); }
  if (a[0] === "login" && a[1] === "--device-auth") {
    const L = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789", pick = (n) => Array.from({ length: n }, () => L[C.crypto.randomInt(L.length)]).join("");
    const code = `${pick(4)}-${pick(5)}`;
    console.log(`Welcome to Codex [v0.164.0]\n\nFollow these steps to sign in with ChatGPT using device code authorization:\n\n1. Open this link in your browser and sign in to your account\n   ${C.cfg.base}/mock-login/codex?code=${code}\n\n2. Enter this one-time code (expires in 15 minutes)\n   ${code}\n\nDevice codes are a common phishing target. Never share this code.\n`);
    for (let i = 0; i < 900; i++) {
      await C.sleep(1000);
      const r = await fetch(`${C.cfg.base}/mock-login/codex/status?code=${code}`).then((x) => x.json()).catch(() => null);
      if (r?.approved) { fs.mkdirSync(dir, { recursive: true }); fs.writeFileSync(authFile, JSON.stringify({ mock: true })); console.log("Successfully logged in"); process.exit(0); }
    }
    console.error("Device code expired"); process.exit(1);
  }
  // app-server: JSON-RPC qua stdin/stdout (danh sách model, tài khoản, hạn mức của gói).
  if (a[0] === "app-server") {
    const rl = require("readline").createInterface({ input: process.stdin });
    const reply = (id, result, error) => process.stdout.write(JSON.stringify({ id, ...(error ? { error } : { result }) }) + "\n");
    const li = () => fs.existsSync(authFile);
    const threads = new Map(), interrupted = new Set();
    const note = (method, params) => process.stdout.write(JSON.stringify({ method, params }) + "\n");
    rl.on("line", (l) => {
      let m; try { m = JSON.parse(l); } catch { return; }
      if (m.id === undefined) return;
      // appServerFail (mock-cli.json): "init" → app-server chết ngay; "thread" → không nhận thread/start (bản CLI cũ): Synchro phải về đường exec.
      if (m.method === "initialize" && C.cfg.appServerFail === "init") process.exit(3);
      if (m.method === "thread/start" && C.cfg.appServerFail === "thread") return reply(m.id, null, { code: -32601, message: "method not found" });
      if (m.method === "initialize") { appLog("initialize"); return C.sleep(C.cfg.codexStartMs ?? 0).then(() => reply(m.id, { userAgent: "synchro/0.164.0 (mock)", codexHome: dir })); }
      // Lượt chat qua app-server (giao thức v2): thread/start | thread/resume → turn/start, sự kiện là thông báo item/*, turn/completed.
      // config của thread là ghi đè dạng khóa có dấu chấm như -c (mcp_servers.synchro.url, features.shell_tool…).
      if (m.method === "thread/start" || m.method === "thread/resume") {
        const p = m.params ?? {}, id = m.method === "thread/start" ? C.uuid() : p.threadId;
        if (m.method === "thread/resume" && !readJ(path.join(dir, "mock-sessions.json"))[id]) return reply(m.id, null, { code: -32600, message: `no rollout found for thread id ${id}` });
        threads.set(id, { config: p.config ?? {}, approval: p.approvalPolicy, sandbox: p.sandbox, model: p.model });
        appLog(m.method, { thread: id, mcp: !!(p.config ?? {})["mcp_servers.synchro.url"] });
        reply(m.id, { thread: { id }, model: p.model ?? "gpt-6.1-sol" });
        if (m.method === "thread/start") note("thread/started", { thread: { id } });
        return;
      }
      if (m.method === "turn/start") {
        const p = m.params ?? {}, t = threads.get(p.threadId);
        if (!t) return reply(m.id, null, { code: -32600, message: `thread not loaded: ${p.threadId}` });
        const turnId = `turn_${C.uuid().slice(0, 8)}`, tid = p.threadId, at = { threadId: tid, turnId };
        appLog("turn/start", { thread: tid });
        reply(m.id, { turn: { id: turnId, status: "inProgress", items: [] } });
        const cam = (item) => ({ ...item, type: CAMEL[item.type] ?? item.type });
        const finish = (turn) => note("turn/completed", { threadId: tid, turn: { id: turnId, ...turn } });
        const stopped = () => interrupted.has(turnId);
        const E = {
          started: (item) => note("item/started", { ...at, item: cam(item) }),
          completed: (item) => note("item/completed", { ...at, item: cam(item) }),
          message: async (id, text) => {
            note("item/started", { ...at, item: { id, type: "agentMessage", text: "" } });
            for (const ch of C.chunks(text, 24)) { if (stopped()) return; note("item/agentMessage/delta", { ...at, itemId: id, delta: ch }); await C.sleep(5); }
            note("item/completed", { ...at, item: { id, type: "agentMessage", text } });
          },
          done: (u) => { if (stopped()) return finish({ status: "interrupted" }); note("thread/tokenUsage/updated", { ...at, tokenUsage: { last: { inputTokens: u.input_tokens, cachedInputTokens: u.cached_input_tokens, outputTokens: u.output_tokens } } }); finish({ status: "completed" }); },
          failed: (message) => { note("error", { ...at, error: { message }, willRetry: false }); finish({ status: "failed", error: { message } }); },
          plan: (items) => { const k = items.findIndex((x) => !x[1]); note("turn/plan/updated", { ...at, explanation: null, plan: items.map(([step, done], j) => ({ step, status: done ? "completed" : j === k ? "inProgress" : "pending" })) }); },
        };
        note("turn/started", { ...at, turn: { id: turnId, status: "inProgress" } });
        const c = t.config;
        void (async () => {
          if (!li()) return E.failed("unexpected status 401 Unauthorized: Missing bearer or basic authentication in header");
          const text = (p.input ?? []).filter((x) => x.type === "text").map((x) => x.text).join("\n");
          const images = (p.input ?? []).filter((x) => x.type === "localImage").map((x) => x.path);
          await chatTurn({ prompt: text, tid, effort: p.effort ?? c.model_reasoning_effort, web: c["tools.web_search"] === true, nativeOn: c["features.image_generation"] !== false,
            mcp: typeof c["mcp_servers.synchro.url"] === "string" ? { url: c["mcp_servers.synchro.url"], approved: c["mcp_servers.synchro.default_tools_approval_mode"] === "approve" } : null,
            images, argvNote: ` [app-server ${JSON.stringify({ approval: t.approval, sandbox: t.sandbox, shell: c["features.shell_tool"] })}]` }, E);
        })().catch((e) => E.failed(String(e)));
        return;
      }
      if (m.method === "turn/interrupt") { interrupted.add(m.params?.turnId); return reply(m.id, {}); }
      if (m.method === "model/list") return reply(m.id, { data: [
        // Như codex thật: mỗi model một bộ mức effort hỗ trợ.
        { id: "gpt-6.1-sol", model: "gpt-6.1-sol", displayName: "GPT-6.1-Sol", hidden: false, supportedReasoningEfforts: ["low", "medium", "high", "xhigh", "max", "ultra"].map((e) => ({ reasoningEffort: e })) },
        { id: "gpt-6-astra", model: "gpt-6-astra", displayName: "GPT-6-Astra", hidden: false, supportedReasoningEfforts: ["low", "medium", "high", "xhigh", "max", "ultra"].map((e) => ({ reasoningEffort: e })) },
        { id: "gpt-5.5", model: "gpt-5.5", displayName: "GPT-5.5", hidden: false, supportedReasoningEfforts: ["low", "medium", "high", "xhigh"].map((e) => ({ reasoningEffort: e })) },
        { id: "codex-internal", model: "codex-internal", displayName: "Internal", hidden: true },
      ] });
      if (m.method === "account/read") return reply(m.id, li() ? { account: { type: "chatgpt", email: "owner@example.com", planType: C.imageMode(dir, "codex").plan ?? "plus" }, requiresOpenaiAuth: true } : { account: null, requiresOpenaiAuth: true });
      if (m.method === "account/rateLimits/read") {
        if (!li()) return reply(m.id, null, { code: -32600, message: "codex account authentication required to read rate limits" });
        const turns = C.totalTurns(dir);
        const now = Math.floor(Date.now() / 1000);
        return reply(m.id, { rateLimits: { limitId: "codex", limitName: null, primary: { usedPercent: Math.min(100, turns * 9), windowDurationMins: 300, resetsAt: now + 3 * 3600 + 600 },
          secondary: { usedPercent: Math.min(100, turns * 3), windowDurationMins: 10080, resetsAt: now + 4 * 86400 }, credits: { hasCredits: false, unlimited: false, balance: null }, planType: "plus", rateLimitReachedType: null }, rateLimitsByLimitId: null });
      }
      reply(m.id, null, { code: -32601, message: "method not found" });
    });
    return new Promise(() => {});
  }
  if (a[0] === "exec") {
    // codexStartMs (mock-cli.json): thời gian khởi động của CLI (đọc cấu hình, đăng nhập, nối MCP) để đo đường exec lạnh với app-server ấm.
    if (C.cfg.codexStartMs) await C.sleep(C.cfg.codexStartMs);
    const resume = a[1] === "resume" ? a[2] : undefined;
    let prompt = await C.readStdin();
    const tid = resume || C.uuid();
    C.out({ type: "thread.started", thread_id: tid });
    C.out({ type: "turn.started" });
    if (!fs.existsSync(authFile)) {
      C.out({ type: "error", message: "unexpected status 401 Unauthorized: Missing bearer or basic authentication in header" });
      await C.sleep(400);
      C.out({ type: "turn.failed", error: { message: "unexpected status 401 Unauthorized: Missing bearer or basic authentication in header" } });
      process.exit(1);
    }
    // Lượt tạo ảnh của Synchro. Vị trí generated_images/<thread_id>/ theo báo cáo công khai, CHƯA kiểm chứng trên tài khoản thật: gói Free của chủ máy chủ không có công cụ này.
    if (C.isImageTurn(prompt)) {
      const m = C.imageMode(dir, "codex");
      C.imageLog(dir, { args: a, codexHome: dir, cwd: process.cwd(), prompt });
      const sess = path.join(dir, "sessions", "2026", `rollout-${tid}.jsonl`);
      fs.mkdirSync(path.dirname(sess), { recursive: true }); fs.writeFileSync(sess, prompt);
      const say = (text) => C.out({ type: "item.completed", item: { id: "item_1", type: "agent_message", text } });
      const end = () => C.out({ type: "turn.completed", usage: { input_tokens: 1, cached_input_tokens: 0, output_tokens: 1 } });
      if (m.mode === "slow") { fs.writeFileSync(path.join(dir, "mock-image.pid"), String(process.pid)); await C.sleep(120_000); }
      if (m.mode === "quota") { C.out({ type: "turn.failed", error: { message: "You've hit your usage limit. Upgrade to Pro or try again in 2 hours 14 minutes." } }); process.exit(1); }
      if (m.mode === "fail") { C.out({ type: "turn.failed", error: { message: "stream disconnected before completion" } }); process.exit(1); }
      if (m.mode === "none") { say("I'm sorry, no image generation tool is available in this environment."); return end(); }
      // Lỗi không qua turn.failed: chỉ sự kiện error, hay chỉ stderr, CLI thoát mã khác 0.
      if (m.mode === "errorevent") { C.out({ type: "error", message: m.message ?? "unexpected status 401 Unauthorized: token expired" }); process.exit(1); }
      if (m.mode === "stderr") { console.error(m.message ?? "You've hit your usage limit. Upgrade to Pro or try again in 2 hours 14 minutes."); process.exit(1); }
      if (m.mode === "reconnect") C.out({ type: "error", message: "Reconnecting... 1/5" });
      for (let i = 0; i < C.imageCount(prompt); i++) C.saveImage(path.join(dir, "generated_images", tid, `ig_${i}.png`), "png");
      say("Saved."); return end();
    }
    const cfgArg = (k) => a.some((x) => x === k || x.startsWith(`${k}=`)) ? a.find((x) => x.startsWith(`${k}=`)).slice(k.length + 1) : undefined;
    const mc = mcpConfig();
    const E = {
      started: (item) => C.out({ type: "item.started", item }),
      completed: (item) => C.out({ type: "item.completed", item }),
      message: async (id, text) => C.out({ type: "item.completed", item: { id, type: "agent_message", text } }),
      done: (usage) => C.out({ type: "turn.completed", usage }),
      failed: (message) => { C.out({ type: "turn.failed", error: { message } }); process.exit(1); },
      plan: (items, phase) => C.out({ type: `item.${phase}`, item: { id: "item_p", type: "todo_list", items: items.map(([text, completed]) => ({ text, completed })) } }),
    };
    // Nhật ký chung với app-server (kiểm thử: không có lượt nào chạy trên bản thread cũ trong bộ nhớ của app-server sau khi exec đã ghi thêm vào phiên).
    appLog("exec", { thread: tid });
    const imgs = a.flatMap((x, i) => (x.startsWith("--image=") ? [x.slice(8)] : x === "-i" || x === "--image" ? [a[i + 1]] : []));
    const effRaw = cfgArg("model_reasoning_effort");
    return chatTurn({ prompt, tid, effort: effRaw ? effRaw.replace(/"/g, "") : undefined, web: a.includes("tools.web_search=true"), nativeOn: !a.includes("features.image_generation=false"),
      mcp: typeof mc.url === "string" ? { url: mc.url, approved: mc.default_tools_approval_mode === "approve" } : null, images: imgs, argvNote: ` [argv ${JSON.stringify(a)}] [home ${path.basename(home)}]` }, E);
  }
  console.error(`mock codex: không hỗ trợ "${a.join(" ")}"`);
  process.exit(2);
})();
