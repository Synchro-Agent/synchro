#!/usr/bin/env node
// Antigravity CLI giả lập (dev:mock), theo đúng hành vi agy 1.4.11 quan sát trên máy chủ thật:
// - chạy không tham số = đăng nhập trong terminal (menu → link → dán mã); phiên đăng nhập ghi xuống đĩa sau khoảng 1 giây;
// - lần mở tương tác đầu tiên sau đăng nhập hiện màn hình làm quen (bảng màu, điều khoản, chia sẻ dữ liệu) — mọi phím gõ vào
//   màn hình đó được ghi lại để kiểm thử chắc chắn Synchro không bấm thay người dùng;
// - `models` in "mã<TAB>Tên" sau dòng "Fetching available models...", gồm biến thể effort và cả model Claude / GPT;
// - --output-format json [--model] [--effort] [--conversation <id>] -p <prompt>. Trong prompt: [mock:quota] → hết hạn mức.
//   --effort với model Claude / GPT (không phải gemini-…) → lỗi "--effort is not supported for model" như agy thật.
// - `mcp add|remove|list` ghi ~/.gemini/config/mcp_config.json đúng định dạng của agy ({ mcpServers: { tên: { serverUrl, headers, disabled } } });
//   ở chế độ -p, công cụ MCP cần duyệt bị tự từ chối trừ khi hook PreToolUse trong ~/.gemini/config/hooks.json trả "allow" (tài liệu của agy).
//   Công cụ MCP mặc định nạp khi cần: model tìm rồi gọi qua tên chung "CallMcpTool"; công cụ có _meta "antigravity/alwaysLoad" được nạp sẵn
//   và gọi bằng tên mcp_synchro_…. Bị từ chối thì lượt dừng sau câu dẫn đầu tiên, nhật ký (--log-file) ghi
//   `Print mode: soft-denying tool confirmation "<tên>"`. Trong prompt: [mock:ondemand] → gọi qua CallMcpTool; [mock:websearch] → search_web
//   (chặn nếu hook không cho); [mock:denyall] → luôn bị chặn; [mock:deny] → model gọi
//   công cụ dựng sẵn run_command (luôn bị từ chối).
const C = require(require("path").join(__dirname, "mock-cli-common.cjs"));
const { fs, path } = C;
const a = process.argv.slice(2);
const home = process.env.HOME || "/tmp", gem = path.join(home, ".gemini"), cli = path.join(gem, "antigravity-cli");
const loginFile = path.join(cli, "antigravity-oauth-token"), onboardFile = path.join(cli, "cache", "onboarding.json"), keysLog = path.join(cli, "onboarding-input.log");
const usage0 = { input_tokens: 0, output_tokens: 0, thinking_tokens: 0, cache_read_tokens: 0, total_tokens: 0 };
const MODELS = [
  ["gemini-4-argon-high", "Gemini 4 Argon (High)"], ["gemini-4-argon-medium", "Gemini 4 Argon (Medium)"], ["gemini-4-argon-low", "Gemini 4 Argon (Low)"],
  ["gemini-3.8-flash-high", "Gemini 3.8 Flash (High)"], ["gemini-3.8-flash-medium", "Gemini 3.8 Flash (Medium)"], ["gemini-3.8-flash-low", "Gemini 3.8 Flash (Low)"],
  ["gemini-3.1-flash-lite", "Gemini 3.1 Flash Lite"],
  ["claude-sonnet-4-6", "Claude Sonnet 4.6 (Thinking)"], ["claude-opus-4-6-thinking", "Claude Opus 4.6 (Thinking)"], ["gpt-oss-120b-medium", "GPT-OSS 120B (Medium)"],
];
const cfgDir = path.join(gem, "config"), mcpFile = path.join(cfgDir, "mcp_config.json"), hooksFile = path.join(cfgDir, "hooks.json");
const readJson = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8") || "{}"); } catch { return {}; } };
// Hook PreToolUse có matcher khớp tên công cụ và lệnh in quyết định "allow".
const hookAllows = (tool) => Object.values(readJson(hooksFile)).some((h) => h?.enabled !== false && (h?.PreToolUse ?? []).some((g) => {
  try { return new RegExp(`^(?:${g.matcher || ".*"})$`).test(tool) && (g.hooks ?? []).some((x) => /decision[\\"' ]*:[\\"' ]*allow/.test(String(x.command ?? ""))); } catch { return false; }
}));
const onboarded = () => { try { return JSON.parse(fs.readFileSync(onboardFile, "utf8")).onboardingComplete === true; } catch { return false; } };

// Lượt tạo ảnh của Synchro: như agy 1.5.0 đo thật, image-generator ghi JPEG vào brain/<conversation_id>/, câu trả lời có link đường dẫn tuyệt đối.
async function agyImage(prompt, conv) {
  const m = C.imageMode(home, "agy"), dir = path.join(cli, "brain", conv), n = C.imageCount(prompt);
  const ref = /image at (\S+) as the reference/.exec(prompt)?.[1];
  C.imageLog(home, { args: a.filter((x) => x !== prompt), home, cwd: process.cwd(), bridge: !!readJson(mcpFile).mcpServers?.synchro, webHook: hookAllows("search_web"), prompt, ref: ref ?? null, refOk: !!ref && fs.existsSync(ref), refHash: ref && fs.existsSync(ref) ? C.crypto.createHash("sha1").update(fs.readFileSync(ref)).digest("hex") : null });
  // Phiên trên đĩa chứa nguyên văn câu lệnh, như CLI thật: Synchro phải xóa sau lượt.
  const sess = path.join(cli, "conversations", `${conv}.pb`);
  fs.mkdirSync(path.dirname(sess), { recursive: true }); fs.writeFileSync(sess, prompt);
  const done = (response, extra = {}) => console.log(JSON.stringify({ conversation_id: conv, status: "SUCCESS", response, error: "", duration_seconds: 1, num_turns: 1, usage: usage0, ...extra }));
  const fail = (error) => { console.log(JSON.stringify({ conversation_id: conv, status: "ERROR", response: "", error, duration_seconds: 0.1, num_turns: 0, usage: usage0 })); process.exit(1); };
  // Bị giết giữa chừng: phiên và ảnh dở đã nằm trên đĩa mà mã phiên chỉ in ra khi xong lượt.
  if (m.mode === "slow") { C.saveImage(path.join(dir, "partial.jpg")); fs.writeFileSync(path.join(home, "mock-image.pid"), String(process.pid)); await C.sleep(120_000); }
  if (m.delayMs) await C.sleep(m.delayMs);
  if (m.mode === "crash") { C.saveImage(path.join(dir, "partial.jpg")); console.error("panic: runtime error"); process.exit(2); }
  if (m.mode === "quota") return fail("RESOURCE_EXHAUSTED: You have exhausted your capacity on this model. Your quota will reset after 3h12m.");
  if (m.mode === "fail") return fail(m.message ?? "INTERNAL: upstream connection reset");
  // Lỗi của image-generator (tiến trình con) không làm hỏng lượt: chỉ nằm trong câu trả lời.
  if (m.mode === "saidquota") return done("I couldn't generate the image, the quota is exhausted.");
  if (m.mode === "none") return done("NO_IMAGE_TOOL");
  if (m.mode === "text") return done("Đã tạo xong ảnh quả táo đỏ, rất đẹp.");
  if (m.mode === "other") return done(`[ảnh](${m.otherPath})`);
  fs.mkdirSync(dir, { recursive: true });
  if (m.mode === "symlink") { fs.symlinkSync(m.otherPath, path.join(dir, "leak.jpg")); return done("xong"); }
  // Ảnh gốc được agy chép vào hội thoại: không phải kết quả.
  if (ref && fs.existsSync(ref)) fs.copyFileSync(ref, path.join(dir, `media__upload${path.extname(ref)}`));
  if (m.mode === "refdenied") { const lf = C.flag(a, "--log-file"); if (lf) fs.appendFileSync(lf, 'tool_confirmation_manager.go:221] Print mode: soft-denying tool confirmation "view_file" at step 2\n'); }
  const files = Array.from({ length: n }, (_, i) => path.join(dir, `small_red_apple_${Date.now()}_${i}.jpg`));
  for (const f of files) C.saveImage(f, m.mode === "bad" ? "bad" : m.mode === "big" ? "big" : "jpg");
  // Mỗi ảnh một nội dung, như ảnh thật: byte thừa sau dấu kết thúc JPEG không làm hỏng ảnh.
  files.forEach((f, i) => fs.appendFileSync(f, `${Date.now()}-${i}-${Math.random()}`));
  return done(files.map((f) => `[${path.basename(f)}](${f})`).join("\n"));
}

(async () => {
  if (a[0] === "--version") return console.log("1.4.11 [mock]");
  const li = fs.existsSync(loginFile);
  if (a[0] === "models") {
    console.log("Fetching available models...");
    if (!li) { console.log("Error: Please sign in to view available models. Launch the CLI without arguments to sign in."); process.exit(1); }
    // Kiểm thử: thêm model như khi Google mở thêm model cho tài khoản (gói chuyển sang trả phí).
    const extra = (() => { try { return fs.readFileSync(path.join(cli, "mock-extra-models"), "utf8").trim().split("\n"); } catch { return []; } })();
    return console.log([...MODELS.map(([id, n]) => `${id}\t${n}`), ...extra].join("\n"));
  }
  if (a[0] === "mcp") {
    const c = readJson(mcpFile); c.mcpServers ??= {};
    if (a[1] === "add") {
      const rest = a.slice(2), headers = {};
      while (rest[0] === "--header" || rest[0] === "-H") { const [k, ...v] = rest[1].split(":"); headers[k.trim()] = v.join(":").trim(); rest.splice(0, 2); }
      const [name, url] = rest;
      if (C.cfg.failMcpAdd) { console.error("mcp add failed"); process.exit(1); }
      if (!name || !url) { console.error("Usage: agy mcp add [flags] <name> <commandOrUrl> [args...]"); process.exit(2); }
      c.mcpServers[name] = { disabled: false, ...(Object.keys(headers).length ? { headers } : {}), serverUrl: url };
      fs.mkdirSync(cfgDir, { recursive: true }); fs.writeFileSync(mcpFile, JSON.stringify(c, null, 2));
      return console.log(`Added MCP server "${name}" (http)`);
    }
    if (a[1] === "remove") {
      if (C.imageMode(home, "agy").mcpRemove === "fail") { console.error("mcp remove failed"); process.exit(1); }
      if (!c.mcpServers[a[2]]) { console.error(`MCP server "${a[2]}" not found`); process.exit(1); }
      delete c.mcpServers[a[2]]; fs.writeFileSync(mcpFile, JSON.stringify(c, null, 2));
      return console.log(`Removed MCP server "${a[2]}"`);
    }
    return console.log(["NAME     TYPE  STATUS   COMMAND/URL", ...Object.entries(c.mcpServers).map(([n, v]) => `${n}  http  ${v.disabled ? "disabled" : "enabled"}  ${v.serverUrl}`)].join("\n"));
  }
  if (a.includes("-p")) {
    let prompt = C.flag(a, "-p") ?? "";
    const conv = C.flag(a, "--conversation") || C.uuid();
    if (!li) {
      console.log(JSON.stringify({ conversation_id: "", status: "ERROR", response: "", error: "authentication failed or timed out", duration_seconds: 0, num_turns: 0, usage: usage0 }));
      console.error("Error: authentication required. Run 'agy' to log in, then retry.");
      process.exit(1);
    }
    if (C.isImageTurn(prompt)) return agyImage(prompt, conv);
    // #sysgrep=<chữ>: cho kiểm thử biết hướng dẫn hệ thống có nhắc tới chữ đó không (đã bỏ chính dấu này khỏi câu hỏi).
    { const m = /#sysgrep=(\S+)/.exec(prompt); if (m) return console.log(JSON.stringify({ conversation_id: conv, status: "SUCCESS", response: `SYSGREP: ${prompt.split(m[0]).join("").includes(m[1]) ? "yes" : "no"}`, error: "", duration_seconds: 0.1, num_turns: 1, usage: usage0 })); }
    // [mock:keepsession]: lượt chat chạy lâu và có phiên trên đĩa ngay từ đầu, mã phiên chỉ báo khi xong: lượt tạo ảnh chạy song song không được xóa nhầm.
    if (prompt.includes("[mock:keepsession")) {
      const sess = path.join(cli, "conversations", `${conv}.pb`);
      fs.mkdirSync(path.dirname(sess), { recursive: true }); fs.writeFileSync(sess, prompt);
      await C.sleep(Number(/\[mock:keepsession=(\d+)\]/.exec(prompt)?.[1] ?? 1500));
      return console.log(JSON.stringify({ conversation_id: conv, status: "SUCCESS", response: "ok", error: "", duration_seconds: 1, num_turns: 1, usage: usage0 }));
    }
    if (prompt.includes("[mock:quota]")) { console.log(JSON.stringify({ conversation_id: conv, status: "ERROR", response: "", error: "RESOURCE_EXHAUSTED: You have exhausted your capacity on this model. Your quota will reset after 3h12m.", duration_seconds: 0.2, num_turns: 0, usage: usage0 })); process.exit(1); }
    // Như agy 1.4.11 thật (nhật ký trên VPS 2026-10-30): model Claude / GPT qua Antigravity không nhận --effort, lượt dừng ngay.
    {
      const m = C.flag(a, "--model"), e = C.flag(a, "--effort");
      // [mock:noeffort]: cả model Gemini này cũng không nhận --effort (Synchro phải tự chạy lại không kèm effort).
      if (m && e && (!/^gemini-/i.test(m) || prompt.includes("[mock:noeffort]"))) {
        const msg = `invalid model selection (--model "${m}" --effort "${e}"): --effort is not supported for model "${m}"`;
        const lf = C.flag(a, "--log-file");
        if (lf) fs.appendFileSync(lf, `E1030 00:00:00.000000       1 printmode.go:308] Print mode: ${msg}\n`);
        console.log(JSON.stringify({ conversation_id: "", status: "ERROR", response: "", error: msg, duration_seconds: 0, num_turns: 0, usage: usage0 }));
        console.error(`Error: ${msg}`);
        process.exit(1);
      }
    }
    // [mock:flaky]: lần đầu gặp prompt này agy lỗi giữa chừng (như lỗi mạng / máy chủ của Google), lần sau chạy bình thường.
    if (prompt.includes("[mock:flaky]")) {
      const ff = path.join(gem, "mock-flaky.json"), seen = readJson(ff), k = C.crypto.createHash("sha1").update(prompt).digest("hex");
      if (!seen[k]) {
        seen[k] = 1; fs.writeFileSync(ff, JSON.stringify(seen));
        console.log(JSON.stringify({ conversation_id: "", status: "ERROR", response: "", error: "INTERNAL: upstream connection reset", duration_seconds: 0.1, num_turns: 0, usage: usage0 }));
        process.exit(1);
      }
    }
    const turn = C.bumpSession(gem, conv);
    const st = C.stallTurn(gem, conv, prompt);
    if (st.stall) return console.log(JSON.stringify({ conversation_id: conv, status: "SUCCESS", response: C.STALL_TEXT, error: "", duration_seconds: 0.2, num_turns: 1, usage: { input_tokens: prompt.length, output_tokens: 10 } }));
    prompt = st.prompt;
    const model = C.flag(a, "--model"), effort = C.flag(a, "--effort");
    // Công cụ của Synchro qua máy chủ MCP "synchro" trong cấu hình chung của tài khoản.
    const srv = readJson(mcpFile).mcpServers?.synchro;
    const logFile = C.flag(a, "--log-file");
    const log = (l) => { if (logFile) fs.appendFileSync(logFile, `I1030 00:00:00.000000       1 ${l}\n`); };
    log("cli_setting_manager.go:96] CLI settings initialized: permissions=<nil>, toolPermission=request-review");
    let note = "";
    const nudged = prompt.includes("<synchro_continue>");
    // [mock:websearch]: model dùng công cụ tìm web dựng sẵn của agy (search_web) — chỉ chạy khi hook cho phép (Synchro bật tìm web),
    // không thì agy tự chặn như bản thật; được nhắc (lượt <synchro_continue>) thì model chuyển sang công cụ của Synchro.
    if (prompt.includes("[mock:websearch]") && !nudged) {
      if (!hookAllows("search_web")) {
        log('tool_confirmation_manager.go:221] Print mode: soft-denying tool confirmation "search_web" at step 2');
        return console.log(JSON.stringify({ conversation_id: conv, status: "SUCCESS", response: "Mình sẽ tìm trên web.", error: "", duration_seconds: 0.3, num_turns: 1, usage: { input_tokens: prompt.length, output_tokens: 6 } }));
      }
      note += " [đã tìm web bằng search_web]";
    }
    if (srv && !srv.disabled) {
      const ask = C.toolAsk(prompt);
      const listed = ask ? (await C.mcp(srv.serverUrl).catch(() => ({ tools: [] }))).tools : [];
      const direct = !prompt.includes("[mock:ondemand]") && listed.some((t) => t.name === ask?.name && t._meta?.["antigravity/alwaysLoad"] === true);
      // [mock:deny]: lượt đầu model gọi công cụ dựng sẵn bị chặn (run_command), được nhắc thì dùng công cụ của Synchro; [mock:denyall]: luôn bị chặn.
      const hookName = prompt.includes("[mock:denyall]") || (prompt.includes("[mock:deny]") && !nudged) ? "run_command" : direct ? `mcp_synchro_${ask?.name}` : "CallMcpTool";
      if (!ask) note += ` [công cụ Synchro: ${(await C.mcp(srv.serverUrl).catch(() => ({ tools: [] }))).tools.length}]`;
      else if (hookName === "run_command" || !hookAllows(hookName)) {
        log(`tool_confirmation_manager.go:221] Print mode: soft-denying tool confirmation "${hookName}" at step 2`);
        await C.sleep(100);
        return console.log(JSON.stringify({ conversation_id: conv, status: "SUCCESS", response: "Mình sẽ xem cách dùng các công cụ trình duyệt trước.", error: "", duration_seconds: 0.3, num_turns: 1, usage: { input_tokens: prompt.length, output_tokens: 12 } }));
      } else {
        // toolLimitMs (mock-cli.json): cắt mỗi lần chờ công cụ như agy thật. Công cụ trả job_id thì model gọi wait_for_result tới khi có kết quả; [mock:nowait] thì model bỏ lửng, kết thúc lượt.
        const limit = { limitMs: C.cfg.toolLimitMs };
        const callOnce = (c) => C.mcp(srv.serverUrl, c, limit).catch((e) => ({ error: { message: String(e) } }));
        const textOf = (r) => (r.error ? `lỗi ${r.error.message}` : (r.result?.content ?? []).filter((x) => x.type === "text").map((x) => x.text).join("\n"));
        let r = await callOnce(ask), out = textOf(r), waits = 0;
        for (let m; !prompt.includes("[mock:nowait]") && (m = /job_id: (job_\w+)/.exec(out)) && waits < 50; waits++) out = textOf(r = await callOnce({ name: "wait_for_result", args: { job_id: m[1] } }));
        if (waits) note += ` [đã chờ ${waits} lần]`;
        // Được nhắc lấy kết quả còn thiếu: job_id nằm trong lời nhắc.
        const nudgeJob = /job_id (job_\w+)/.exec(prompt.split("Còn công cụ chưa lấy kết quả").pop() ?? "");
        if (nudgeJob && prompt.includes("Còn công cụ chưa lấy kết quả")) out = textOf(await callOnce({ name: "wait_for_result", args: { job_id: nudgeJob[1] } }));
        note += ` [đã dùng ${ask.name}${direct ? "" : " qua CallMcpTool"}: ${out.replace(/\s+/g, " ").slice(0, 160)}]`;
      }
    }
    // Như agy thật ở print mode: không có cờ gửi tệp; model mở tệp trong thư mục làm việc bằng công cụ xem tệp (view_file).
    // Giả lập: đọc đúng các đường dẫn trong khối <attachments> (chỉ nhận tệp nằm trong thư mục làm việc).
    const att = /<attachments>([\s\S]*?)<\/attachments>/.exec(prompt)?.[1] ?? "";
    const files = [...att.matchAll(/^\d+\. (\S+) \(/gm)].map((m) => m[1]);
    const seen = files.map((f) => !path.resolve(f).startsWith(process.cwd() + path.sep) ? `ngoài thư mục làm việc: ${f}` : !fs.existsSync(f) ? `không có tệp: ${f}` : `${C.mediaDesc(fs.readFileSync(f))} (view_file)`);
    // [mock:nativeimage]: model tự gọi image-generator của Antigravity ngay trong lượt chat: ảnh nằm trong thư mục hội thoại, câu trả lời chỉ ghi đường dẫn trên máy chủ.
    if (prompt.includes("[mock:nativeimage]") || prompt.includes("mocknativeimage")) {
      const f = path.join(cli, "brain", conv, `native_${Date.now()}.jpg`);
      C.saveImage(f);
      return console.log(JSON.stringify({ conversation_id: conv, status: "SUCCESS", response: `Mình đã tạo ảnh: ![táo](${f}) và [tải ảnh](file://${f}). Lưu tại ${f}`, error: "", duration_seconds: 37, num_turns: 1, usage: { input_tokens: 1, output_tokens: 1 } }));
    }
    const text = /#media/.test(prompt) && !C.isTitleAsk(prompt) && !C.mockBrain(prompt) ? C.mediaReply(seen) : C.mockBrain(prompt) ?? (C.isTitleAsk(prompt) ? C.mockTitle(prompt) : /#prefs/.test(prompt) ? C.prefsEcho(prompt) : C.reply("Gemini (Antigravity)", prompt, turn) + note + (model ? ` [model ${model}]` : "") + (effort ? ` [effort ${effort}]` : ""));
    await C.sleep(200);
    return console.log(JSON.stringify({ conversation_id: conv, status: "SUCCESS", response: text, error: "", duration_seconds: 0.4, num_turns: 1, usage: { input_tokens: prompt.length, output_tokens: text.length, thinking_tokens: 12, cache_read_tokens: 0, total_tokens: prompt.length + text.length + 12 } }));
  }
  if (a.length === 0) {
    if (!process.stdin.isTTY) { console.error("Error: interactive mode requires a terminal."); process.exit(1); }
    const rl = require("readline").createInterface({ input: process.stdin });
    const lines = [];
    let waiting = null;
    rl.on("line", (l) => { if (waiting) { const w = waiting; waiting = null; w(l.trim()); } else lines.push(l.trim()); });
    const next = (prompt = "") => { process.stdout.write(prompt); return lines.length ? Promise.resolve(lines.shift()) : new Promise((r) => (waiting = r)); };
    const chat = async () => {
      if (!onboarded()) {
        // Màn hình làm quen: chỉ ghi lại phím nhận được, không tự hoàn tất (người dùng phải tự chọn).
        console.log(" Welcome to Antigravity CLI!\n Choose your color scheme:\n  > terminal\n    light\n    dark\n [Next]\n  ↑/↓ Navigate · enter Confirm");
        for (;;) { const k = await next(); fs.mkdirSync(cli, { recursive: true }); fs.appendFileSync(keysLog, JSON.stringify(k) + "\n"); console.log(" Terms of Service & Data Use\n  > [x] Yes, I agree to help improve Antigravity CLI\n [Previous]      [Done]"); }
      }
      console.log(" Welcome back to the Antigravity CLI.\n > Ask anything");
      for (;;) {
        const l = await next();
        if (/^\/(exit|quit)\b/.test(l)) process.exit(0);
        if (/^\/(usage|quota)\b/.test(l)) {
          const turns = C.totalTurns(gem), g5 = Math.max(0, 100 - turns * 12), gw = Math.max(0, 100 - turns * 4);
          // Bố cục thật của agy 1.4.7: nhãn, thanh %, dòng "Refreshes in …" trên các dòng riêng.
          const bar = (p) => `[${"█".repeat(Math.round(p / 2))}${"░".repeat(50 - Math.round(p / 2))}] ${p.toFixed(2)}%`;
          console.log(`└ Models & Quota\n  Account: owner@example.com\nGEMINI MODELS\n  Models within this group: Gemini Flash, Gemini Pro\n  Weekly Limit Remaining\n${bar(gw)}\nRefreshes in 122h 2m\n  Five Hour Limit Remaining\n${bar(g5)}\nRefreshes in 3h 12m\nCLAUDE AND GPT MODELS\n  Models within this group: Claude Opus, Claude Sonnet, GPT-OSS\n  Weekly Limit Remaining\n${bar(100)}\nRefreshes in 122h 2m\n  Five Hour Limit Remaining\n${bar(100)}\nRefreshes in 4h 59m\n  ↑/↓ Scroll · esc Close`);
        }
      }
    };
    if (li) return chat();
    console.log(" Welcome to the Antigravity CLI. You are currently not signed in.\n Select login method:\n > 1. Google OAuth\n   2. Use a Google Cloud project\n ↑/↓ Navigate · enter Select");
    await next();
    console.log(` ⣷  Signing in...\nYour browser should open automatically. If not: ${C.cfg.base}/mock-login/agy?access_type=offline&client_id=mock&state=${C.uuid()}\n`);
    const code = await next("If you aren't automatically redirected, paste the authorization code below:\n");
    if (code !== "MOCK-AGY-OK") { console.log("Error: invalid authorization code."); process.exit(1); }
    // Như agy thật: phiên đăng nhập ghi xuống đĩa ngay sau khi xác thực xong (chậm một chút), rồi vào màn hình làm quen / chat.
    setTimeout(() => { fs.mkdirSync(cli, { recursive: true }); fs.writeFileSync(loginFile, "mock-token"); }, 1000);
    await C.sleep(300);
    return chat();
  }
  console.error(`mock agy: không hỗ trợ "${a.join(" ")}"`);
  process.exit(2);
})();
