# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-mock/
/.next-mockfast/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env / cache
.mkvenv/
.cache/

# dữ liệu skill do người dùng tải lên
/data/
# dữ liệu của npm run dev:mock (API giả lập)
/data-mock/

# Kiểm thử (CI)
.next-ci/
mock.log

# Phim giới thiệu (Blueprint H3.9): không nằm trong git. Production: nginx phục vụ /intro/*.mp4 từ /var/www/synchro-media/intro/
# (docs/van-hanh.md). Máy dev / CI: node tools/fetch-intro.mjs (dev:mock tự chạy). Ảnh chờ synchro-intro-poster.jpg vẫn trong git.
/public/intro/*.mp4
